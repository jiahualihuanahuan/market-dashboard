# Copy values you want to override into the shell before `docker compose up`,
# or into a file named `.env` next to docker-compose.yml (Compose reads it).
# Do not commit a real CARE_TOKEN.

# Port on the host. Other machines use http://<host-ip>:<HOST_PORT>
HOST_PORT=8080

# Time zone for the daily job. Default is Toronto.
TZ=America/Toronto

# Daily refresh, 24-hour local time.
CARE_AT=06:30

# Set to 0 to skip the refresh that runs once when the container starts.
CARE_ON_START=1

# Optional. Empty = generated on first start and saved in the data volume.
CARE_TOKEN=

# Optional Postgres. This desk runs without one.
DATABASE_URL=
