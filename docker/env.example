# Copy values you want to override into a file named `.env` next to docker-compose.yml (Compose reads it).
# Do not commit a real CARE_TOKEN.

# Port on the host. Other machines use http://<host-ip>:<HOST_PORT>
HOST_PORT=8080

# Time zone for the daily job. Default is Toronto.
TZ=America/Toronto

# Daily forced refresh, 24-hour local time, and once at container start (set CARE_ON_START=0 to skip).
CARE_AT=06:30
CARE_ON_START=1

# Optional. Empty = generated on first start and saved in the data volume.
CARE_TOKEN=

# Optional Postgres. The desk runs without one.
DATABASE_URL=

# --- Refresh cadence ---------------------------------------------------------
# Live prices (Yahoo spark, 20 symbols per request) while the US market is open, minutes.
# Outside hours prices refresh once after each close.
PRICE_REFRESH_MIN=15
# Daily bars + ETF distributions (1-month tail merged onto the cache), hours. Also once after each close.
BARS_REFRESH_HOURS=24
# Full 5-year re-download to catch splits and vendor corrections, days.
BARS_FULL_DAYS=7
# FRED (credit spreads, 10Y, curve, unemployment, Sahm), hours. Tail-only fetch with a 400-day overlap for revisions;
# full re-read weekly.
FRED_REFRESH_HOURS=12

# Income tab. Comma-separated Yahoo tickers (Canadian listings end in .TO).
INCOME_TICKERS=
